
@model BaseViewModel
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ASP.NET TO-BE Board Template</title>
    <link rel="stylesheet" href="~/css/vendor.min.css" />
    <link rel="stylesheet" href="~/css/app.min.css"/>
</head>
<body>
	<!-- BEGIN #loader -->
	<div id="loader" class="app-loader">
		<span class="spinner"></span>
	</div>
	<!-- END #loader -->
	<!-- BEGIN #app -->
	<div id="app" class="app app-header-fixed app-sidebar-fixed">
		<!-- BEGIN #header -->
		<div id="header" class="app-header">
			<!-- BEGIN navbar-header -->
			<div class="navbar-header">
				<a href="@Url.Action("Index", "Board")" class="navbar-brand"><span class="navbar-logo"></span> <b>ASP.NET Board</b>&nbsp; Template</a>
				<button type="button" class="navbar-mobile-toggler" data-toggle="app-sidebar-mobile">
					<span class="icon-bar"></span>
					<span class="icon-bar"></span>
					<span class="icon-bar"></span>
				</button>
			</div>
			<!-- END navbar-header -->
			<!-- BEGIN header-nav -->
			<div class="navbar-nav">
				@if (!Model.LoginSession.IsAuthenticated)
				{
					<div class="navbar-item navbar-user dropdown">
						<a href="@Url.Action("Login", "Home")" class="navbar-link d-flex align-items-center">
							<div class="image image-icon bg-gray-800 text-gray-600">
								<i class="icon-login h3 d-block"></i>
							</div>
							<span class="d-none d-md-inline">로그인</span>
						</a>
					</div>
				}
				else
				{
					<div class="navbar-item navbar-user dropdown">
						<a href="#" class="navbar-link dropdown-toggle d-flex align-items-center" data-bs-toggle="dropdown">
							<div class="image image-icon bg-gray-800 text-gray-600">
								<i class="fa-solid fa-user"></i>
							</div>
							<span class="d-none d-md-inline">@Model.LoginSession?.DisplayName</span> <b class="caret ms-10px"></b>
						</a>
						<div class="dropdown-menu dropdown-menu-end me-1">
							<label class="dropdown-item">로그인시간 @Model.LoginSession?.WhenLogin.ToString()</label>
							<a href="@Url.Action("Logout", "Home")" class="dropdown-item">로그아웃</a>
						</div>
					</div>
				}
			</div>
			<!-- END header-nav -->
		</div>
		<!-- END #header -->
		<!-- BEGIN #sidebar -->
		<div id="sidebar" class="app-sidebar">
			<!-- BEGIN scrollbar -->
			<div class="app-sidebar-content" data-scrollbar="true" data-height="100%">
				<!-- BEGIN menu -->
				<div class="menu">
					<div class="menu-item active">
						<a href="@Url.Action("Index","Board")" class="menu-link">
							<div class="menu-icon">
								<i class="fa-solid fa-book"></i>
							</div>
							<div class="menu-text">게시판</div>
						</a>
					</div>
					<div class="menu-item">
						<a href="@Url.Action("ClaimView", "MsalAuthentication")" class="menu-link">
							<div class="menu-icon">
								<i class="fa-solid fa-info"></i>
							</div>
							<div class="menu-text">Msal 인증 보기</div>
						</a>
					</div>
				</div>
				<!-- END menu -->
			</div>
			<!-- END scrollbar -->
		</div>
		<div class="app-sidebar-bg"></div>
		<div class="app-sidebar-mobile-backdrop"><a href="#" data-dismiss="app-sidebar-mobile" class="stretched-link"></a></div>
		<!-- END #sidebar -->
		@RenderBody()
	</div>
	<!-- END #app -->
    <script src="~/js/vendor.min.js" asp-append-version="true"></script>
    <script src="~/js/app.min.js" asp-append-version="true"></script>
</body>
</html>
