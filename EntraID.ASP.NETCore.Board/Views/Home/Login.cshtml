@model LoginViewModel
<!-- BEGIN #content -->
<div id="content" class="app-content">
	<!-- BEGIN breadcrumb -->
	<ol class="breadcrumb float-xl-end">
		<li class="breadcrumb-item active">로그인</li>
	</ol>
	<!-- END breadcrumb -->
	<!-- BEGIN page-header -->
	<h1 class="page-header">로그인하기 <small>사용자 이름과 암호를 입력하세요...</small></h1>
	<!-- END page-header -->
	<!-- BEGIN panel -->
	<div class="panel panel-inverse">
		<div class="panel-heading">
			<h4 class="panel-title">로그인 정보</h4>
			<div class="panel-heading-btn">
				<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i class="fa fa-expand"></i></a>
				<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i class="fa fa-redo"></i></a>
				<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i class="fa fa-minus"></i></a>
				<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i class="fa fa-times"></i></a>
			</div>
		</div>
		<div class="panel-body">
			<form method="post">
			<div class="row mb-15px">
				<label class="form-label col-form-label col-md-3">사용자 ID</label>
				<div class="col-sm-9">
					<input autofocus type="text" name="UserName" class="form-control" placeholder="사용자 ID를 입력하세요."/>
				</div>
			</div>
				<div class="row mb-15px">
					<label class="form-label col-form-label col-md-3">암호</label>
					<div class="col-sm-9">
						<input type="password" name="Password" class="form-control" placeholder="암호를 입력하세요."/>
					</div>
				</div>
				<div class="row mb-15px">
					<input style="width: 150px;" type="submit" class="btn btn-primary" value="로그인"></input>
				</div>
				<input type="hidden" value="@Model.ReturnUrl" name="ReturnUrl" />
			</form>
			<div class="row mb-15px">
				하기의 테스트 사용자를 이용해서 로그인 하십시오.
				<table class="table">
					<tr>
						<td>사용자 Id</td><td>암호</td>
					</tr>
					@foreach (var userInfo in UserManager.Users)
					{
						<tr>
							<td>@userInfo.UserName</td>
							<td>@userInfo.Password</td>
						</tr>
					}
				</table>
			</div>
		</div>
	</div>
	<!-- END panel -->
</div>
<!-- END #content -->

<script type="text/javascript">
	
	@if(Model.InvalidCredential)
	{
		@Html.Raw("alert('사용자 ID와 암호가 올바르지 않습니다.');")
	}
</script>