@model PostItemViewModel
<!-- BEGIN #content -->
<div id="content" class="app-content">
	<!-- BEGIN breadcrumb -->
	<ol class="breadcrumb float-xl-end">
		<li class="breadcrumb-item">게시판</li>
		<li class="breadcrumb-item active">글보기</li>
	</ol>
	<!-- END breadcrumb -->
	<!-- BEGIN page-header -->
	<h1 class="page-header">게시글보기</h1>
	<!-- END page-header -->
	<!-- BEGIN panel -->
	<div class="panel panel-inverse">
		<div class="panel-heading">
			<h4 class="panel-title">게시글보기</h4>
			<div class="panel-heading-btn">
				<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i class="fa-solid fa-expand"></i></a>
				<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i class="fa-solid fa-redo"></i></a>
				<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i class="fa-solid fa-minus"></i></a>
				<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i class="fa-solid fa-times"></i></a>
			</div>
		</div>
		<div class="panel-body">

			<input type="button" class="btn btn-default" value="목록보기" onclick="document.location.href = '@Url.Action("Index")'" />
			<div class="row mb-15px">
				<label class="form-label col-form-label col-md-3">제목</label>
				<div class="col-md-9">
					@Model.PostItem.Subject
				</div>
			</div>
			<div class="row mb-15px">
				<label class="form-label col-form-label col-md-3">작성자</label>
				<div class="col-md-9">
					@Model.WriterDisplayName
				</div>
			</div>
			<div class="row mb-15px">
				<label class="form-label col-form-label col-md-3">읽은 휫수</label>
				<div class="col-md-9">
					@Model.PostItem.ReadCount
				</div>
			</div>
			<div class="row mb-15px">
				<label class="form-label col-form-label col-md-3">작성일자</label>
				<div class="col-md-9">
					@Model.PostItem.WhenWrited
				</div>
			</div>
			<div class="row mb-15px">
				<label class="form-label col-form-label col-md-3">내용</label>
				<div class="col-md-9">
					@Model.PostItem.Content
				</div>
			</div>

		</div>
	</div>
	<!-- END panel -->
</div>
<!-- END #content -->